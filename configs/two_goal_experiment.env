# Single selects prove/disprove each round; Dual always executes both Lean-verified lanes.
SEARCH_ARCHITECTURE=two_goal
FALSE_DECISION_MODE=two_goal
# Agent models
NATURAL_MODEL=openai/gpt-6-luna
# Compatibility route only; no False Reasoner node in the two-goal architecture.
FALSE_REASON_MODEL=openai/gpt-6-luna
RETRY_MODEL=openai/gpt-6-luna
LEAN_MODEL=openai/gpt-6-luna
ORCHESTRATOR_MODEL=openai/gpt-6-luna-pro

# Per-execution budget; use --repetitions 5 for Pass@5
MAX_ROUNDS=3
MAX_TRIALS=3
MODEL_TIMEOUT_SETS_01_03=900
MODEL_TIMEOUT_SETS_04_05=900
VERIFY_TIMEOUT=300

# Final baseline memory: strategy, independent informal proof and Lean code; no Repair guidance or compiler logs.
DUAL_MEMORY_SCHEMA=paper_merged

# Separate transport/output recovery budgets; infrastructure failures abort evaluation.
DUAL_ARC_API_MAX_ATTEMPTS=3
DUAL_ARC_API_MAX_TRANSPORT_ATTEMPTS=5
DUAL_ARC_OPENROUTER_PROVIDER=openai/flex

# Pin the exact Flex endpoint; never silently fall back to Standard or another model.
DUAL_ARC_OPENROUTER_MODEL_PROVIDERS='{"openai/gpt-6-luna-pro":"openai/flex","openai/gpt-6-luna":"openai/flex"}'
# Lowest worker effort. Pro planner keeps its model alias's default Pro behavior.
DUAL_ARC_REASONING_EFFORT=
DUAL_ARC_MODEL_REASONING_EFFORTS='{"openai/gpt-6-luna":"none"}'

# Bound generated output; Repair needs short edits, not another full proof.
DUAL_ARC_MAX_OUTPUT_TOKENS=16384
DUAL_ARC_REPAIR_MAX_OUTPUT_TOKENS=2048
DUAL_ARC_REPAIR_TIMEOUT_SECONDS=900

# Same compiler-grounded API context for Single and Dual; core instructions unchanged.
DUAL_ARC_LEAN_DECLARATIONS=1

# Identical source locations and actual edit history for both architectures.
DUAL_ARC_REPAIR_CONTEXT=1
