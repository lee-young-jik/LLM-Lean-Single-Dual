# Required by the paper reproduction configuration.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Only required when using a direct OpenAI API model route.
OPENAI_API_KEY=

# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=LLM-Lean Single Dual Reproduction

# Optional LangSmith tracing. Local audit logs work without it.
# To enable cloud tracing, fill the key and set both tracing flags to true.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=single-dual-two-goal

# Optional runtime controls. The paper script sets the required values itself.
DUAL_ARC_MODEL_CLIENT=
DUAL_ARC_DUAL_MEMORY_SCHEMA=
DUAL_ARC_FALSE_REVIEW_PROJECT=
DUAL_ARC_LANGSMITH_FALSE_ONLY=
DUAL_ARC_MAX_OUTPUT_TOKENS=
DUAL_ARC_MAX_VERIFIER_RSS_KIB=
DUAL_ARC_STRICT_TIMEOUT_GUARD=
